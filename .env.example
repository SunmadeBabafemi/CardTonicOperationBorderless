NODE_ENV=development
PORT=3000
# Compose supplies its own isolated database URL. This URL is for host development.
DATABASE_URL=postgresql://borderflow:borderflow@127.0.0.1:5434/borderflow
DATABASE_POOL_MAX=10
FX_MODE=live
FX_BASE_URL=https://api.frankfurter.dev
FX_TIMEOUT_MS=2000
FX_REFRESH_SECONDS=21600
FX_REFRESH_CRON=0 */6 * * *
FX_MAX_AGE_DAYS=7
FX_QUOTE_TTL_SECONDS=300
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=borderflow
REDIS_TIMEOUT_MS=1000
RATE_LIMIT_PER_MINUTE=120
# Generate with: node -e "console.log(require('node:crypto').randomBytes(64).toString('base64url'))"
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=borderflow
AUTH_JWT_AUDIENCE=borderflow-api
AUTH_ACCESS_TTL_SECONDS=3600
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_RATE_LIMIT_PER_MINUTE=10
# Signs simulated bank-provider webhooks for virtual account funding. Leave empty to disable.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
VBA_WEBHOOK_SECRET=
# Background issuance of virtual bank accounts: retries with exponential backoff.
VBA_PROVISION_ATTEMPTS=5
VBA_PROVISION_BACKOFF_MS=2000
