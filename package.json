{
  "name": "borderflow",
  "version": "0.0.1",
  "description": "Operation Borderless: an atomic multi-currency stablecoin wallet sandbox",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.{cjs,ts}\" \"*.json\" \"*.cjs\" \"*.yml\" \"README.md\" .swcrc .swcrc.dev.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.{cjs,ts}\" \"*.json\" \"*.cjs\" \"*.yml\" \"README.md\" .swcrc .swcrc.dev.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch --config nest-cli.dev.json",
    "dev": "nest start --watch --config nest-cli.dev.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "lint:fix": "yarn lint --fix",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/typeorm.datasource.ts",
    "migration": "npm run build && npm run typeorm migration:run",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js migration:run -d dist/database/typeorm.datasource.js",
    "migration:generate": "node scripts/migration.cjs generate",
    "migration:create": "node scripts/migration.cjs create",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "docs:generate": "node -r ts-node/register -r tsconfig-paths/register scripts/generateOpenapi.ts",
    "test": "node scripts/test.cjs",
    "test:unit": "jest --selectProjects unit --runInBand",
    "test:api": "jest --selectProjects api --runInBand",
    "test:cov": "node scripts/test.cjs --coverage",
    "docs:hoppscotch": "node scripts/generateHoppscotch.cjs"
  },
  "dependencies": {
    "@nestjs/bullmq": "10.2.3",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/typeorm": "10.0.2",
    "bcrypt": "6.0.0",
    "bullmq": "5.34.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "decimal.js": "10.6.0",
    "dotenv": "16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.2",
    "libphonenumber-js": "1.12.24",
    "lossless-json": "4.3.0",
    "pg": "8.16.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.20",
    "@types/bcrypt": "6.0.0",
    "@types/express": "4.17.23",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^20.3.1",
    "@types/pg": "8.15.5",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  }
}
